<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Kojima"
      Manufacturer="mengtiankf"
      Version="1.0.0.0"
      UpgradeCode="4B7C1E52-8D3A-42F1-9A6C-E5D2B8F71C43"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="已经安装了更新版本的 Kojima。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="KojimaIcon" SourceFile="$(var.ProjectDir)assets\kojima.ico" />
    <Property Id="ARPPRODUCTICON" Value="KojimaIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Kojima" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Kojima" />
    </StandardDirectory>

    <Feature Id="Main" Title="Kojima" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupEntry" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.ProjectDir)publish\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="B3C0F7A1-6D24-4E88-9F51-2A7D4C6E1B90">
      <Shortcut Id="AppShortcut" Name="Kojima" Description="Kojima 灵动岛"
                Target="[INSTALLFOLDER]Kojima.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Kojima" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartupEntry" Directory="INSTALLFOLDER" Guid="0E5D9C48-7A31-4F62-B8D0-93C1E7F5A264">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Kojima"
                     Type="string" Value="[INSTALLFOLDER]Kojima.exe" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Kojima" Name="version" Type="string" Value="1.0.0" />
    </Component>
  </Package>
</Wix>
