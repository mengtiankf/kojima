<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kojima.Core</RootNamespace>
    <AssemblyName>Kojima.Core</AssemblyName>
    <Version>1.3.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\themes\*.json" LogicalName="themes/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI（ProtectedData）在 net10.0 上是独立包；Windows 专用，调用处标注 SupportedOSPlatform。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
