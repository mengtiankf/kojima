<UserControl x:Class="Kojima.Shell.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Kojima.Shell.Views"
             Height="286">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 媒体卡 -->
        <Border x:Name="MediaCard" Grid.Column="0" CornerRadius="16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="CoverBox" Grid.RowSpan="2" Width="86" Height="86" CornerRadius="14"
                        VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons"
                               FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,4,0,0">
                    <TextBlock x:Name="MediaTitle" Text="未在播放" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MediaArtist" Text="打开任意播放器试试" FontSize="10.5" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MediaTime" Text="0:00 / 0:00" FontSize="9.5" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Bottom">
                    <TextBlock x:Name="PrevGlyph" Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="15"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Border x:Name="PlayPill" Width="34" Height="34" CornerRadius="17">
                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="NextGlyph" Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="15"
                               Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 天气 -->
            <Border x:Name="WeatherCard" Grid.Row="0" Grid.Column="0" CornerRadius="16" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="WeatherCity" Text="本地" FontSize="10.5" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <views:WeatherIcon x:Name="WeatherGlyph" Width="24" Height="24"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="WeatherTemp" Text="--°" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="WeatherDesc" Text="等待天气数据" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 时钟 -->
            <Border x:Name="ClockCard" Grid.Row="0" Grid.Column="2" CornerRadius="16" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="DateText" Text="--" FontSize="10.5" />
                    <TextBlock x:Name="TimeText" Text="--:--" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="WeekText" Text="" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 快捷操作 -->
            <Border x:Name="ActionCard" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="16"
                    Padding="8">
                <UniformGrid Rows="1" Columns="4">
                    <StackPanel x:Name="ActMute" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Cursor="Hand">
                        <TextBlock x:Name="ActMuteGlyph" Text="&#xE767;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActMuteText" Text="静音" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ActSub" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Cursor="Hand">
                        <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="实时字幕" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ActSnip" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Cursor="Hand">
                        <TextBlock Text="&#xE924;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="截图" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ActSettings" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Cursor="Hand">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="设置" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
