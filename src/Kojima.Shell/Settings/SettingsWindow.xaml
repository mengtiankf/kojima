<Window x:Class="Kojima.Shell.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Kojima.Shell.Theme"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Kojima 设置" Width="1000" Height="740" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="True"
        FontFamily="{x:Static theme:ThemeRuntime.UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" PreviewKeyDown="OnPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindow.Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 无阴影：14px 圆角 + 1px 发丝描边 -->
    <Border x:Name="Shell" CornerRadius="14" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 侧栏 ==================== -->
            <Border Grid.Column="0" CornerRadius="13,0,0,13" BorderThickness="0,0,1,0"
                    Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource HairlineBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Height="78" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="K" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Kojima" FontSize="14.5" FontWeight="SemiBold"/>
                                <TextBlock Text="设置" FontSize="10.5" Margin="0,1,0,0"
                                           Foreground="{DynamicResource Text3Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="NavList" Grid.Row="1" Margin="12,4,12,0">
                        <RadioButton x:Name="NavGeneral" GroupName="Nav" Tag="0" Style="{StaticResource NavItem}"
                                     Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGeneral}" StrokeThickness="1.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="通用" Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Nav" Tag="1" Style="{StaticResource NavItem}" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconAppearance}" StrokeThickness="1.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="外观" Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavFeatures" GroupName="Nav" Tag="2" Style="{StaticResource NavItem}" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFeatures}" StrokeThickness="1.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="功能" Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Nav" Tag="3" Style="{StaticResource NavItem}" Checked="OnNavChecked" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconUsage}" StrokeThickness="1.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="用量" Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Nav" Tag="4" Style="{StaticResource NavItem}" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconAbout}" StrokeThickness="1.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="关于" Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="20,0,20,18">
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,14" Opacity="0.8"/>
                        <TextBlock x:Name="VersionLabel" Text="1.2.1" FontSize="10.5" Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 内容 ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="78" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <StackPanel Margin="30,0,64,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Text="通用"/>
                        <TextBlock x:Name="PageDescText" Style="{StaticResource PageDesc}" Margin="0,3,0,0"
                                   Text="启动方式、灵动岛的形态与基础交互。"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" AutomationProperties.Name="关闭设置"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                            ToolTip="关闭 (Esc)" Click="OnCloseClick"/>
                </Grid>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <!-- 通用 -->
                    <ScrollViewer x:Name="PageGeneral" Style="{StaticResource PageScroll}" Margin="30,0,18,0">
                        <StackPanel Margin="0,2,0,26">
                            <TextBlock Text="启动" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="开机启动" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="登录 Windows 后自动启动 Kojima" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="StartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="灵动岛" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="位置" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="只支持屏幕顶部的三个位置" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" Margin="24,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="PosCenter" GroupName="Position" Style="{StaticResource Segment}"
                                                             Content="上居中"/>
                                                <RadioButton x:Name="PosLeft" GroupName="Position" Style="{StaticResource Segment}"
                                                             Content="上靠左"/>
                                                <RadioButton x:Name="PosRight" GroupName="Position" Style="{StaticResource Segment}"
                                                             Content="上靠右"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="收起形态" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="刘海贴合屏幕顶部，胶囊更紧凑，指示条最简" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" Margin="24,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ShapeNotch" GroupName="Shape" Style="{StaticResource Segment}"
                                                             Content="刘海"/>
                                                <RadioButton x:Name="ShapeCapsule" GroupName="Shape" Style="{StaticResource Segment}"
                                                             Content="胶囊"/>
                                                <RadioButton x:Name="ShapeIndicator" GroupName="Shape" Style="{StaticResource Segment}"
                                                             Content="指示条"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <StackPanel Margin="0,12,0,14">
                                        <TextBlock Text="收起状态" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="灵动岛收起后在顶部显示的内容" Style="{StaticResource RowDesc}"/>
                                        <Border Style="{StaticResource SegmentGroup}" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="CompactClockWeather" GroupName="Compact" Style="{StaticResource SegmentTight}"
                                                             Content="时钟和天气"/>
                                                <RadioButton x:Name="CompactClock" GroupName="Compact" Style="{StaticResource SegmentTight}"
                                                             Content="仅时钟"/>
                                                <RadioButton x:Name="CompactWeather" GroupName="Compact" Style="{StaticResource SegmentTight}"
                                                             Content="仅天气"/>
                                                <RadioButton x:Name="CompactMedia" GroupName="Compact" Style="{StaticResource SegmentTight}"
                                                             Content="媒体信息"/>
                                                <RadioButton x:Name="CompactNone" GroupName="Compact" Style="{StaticResource SegmentTight}"
                                                             Content="不显示"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="全屏时隐藏" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="全屏应用前台时自动隐藏灵动岛" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HideFullscreenSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="交互与动效" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="悬停展开延迟" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="鼠标停留多久后展开" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Slider x:Name="HoverSlider" Style="{StaticResource SlimSlider}" Width="186"
                                                    Minimum="0" Maximum="600" SmallChange="10" LargeChange="50"/>
                                            <TextBlock Width="62" Margin="14,0,0,0" TextAlignment="Right" FontSize="11.5"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"
                                                       Text="{Binding Value, ElementName=HoverSlider, StringFormat='{}{0:0} ms'}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="收起延迟" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="鼠标离开后多久收起" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Slider x:Name="CollapseSlider" Style="{StaticResource SlimSlider}" Width="186"
                                                    Minimum="0" Maximum="1000" SmallChange="20" LargeChange="100"/>
                                            <TextBlock Width="62" Margin="14,0,0,0" TextAlignment="Right" FontSize="11.5"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"
                                                       Text="{Binding Value, ElementName=CollapseSlider, StringFormat='{}{0:0} ms'}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="不透明度" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="展开面板的透明度" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Slider x:Name="OpacitySlider" Style="{StaticResource SlimSlider}" Width="186"
                                                    Minimum="0.6" Maximum="1.0" SmallChange="0.02" LargeChange="0.1"/>
                                            <TextBlock Width="62" Margin="14,0,0,0" TextAlignment="Right" FontSize="11.5"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"
                                                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat='{}{0:P0}'}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 外观 -->
                    <ScrollViewer x:Name="PageAppearance" Style="{StaticResource PageScroll}" Margin="30,0,18,0"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,2,0,26">
                            <TextBlock Text="主题" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="2,0,2,10">
                                        <TextBlock Text="当前主题" Style="{StaticResource Hint}"/>
                                        <TextBlock x:Name="CurrentThemeText" HorizontalAlignment="Right" FontSize="11.5"
                                                   Foreground="{DynamicResource AccentBrush}" Text="—"/>
                                    </Grid>
                                    <ListBox x:Name="ThemeList" Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource ThemeItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             SelectionChanged="OnThemeSelectionChanged">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Id}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding ByLine}" Style="{StaticResource Hint}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Ellipse Width="9" Height="9" Margin="0,0,5,0"
                                                                 Fill="{Binding SurfaceSwatch}"
                                                                 Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1"/>
                                                        <Ellipse Width="9" Height="9" Margin="0,0,5,0"
                                                                 Fill="{Binding TextSwatch}"
                                                                 Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1"/>
                                                        <Ellipse Width="9" Height="9"
                                                                 Fill="{Binding AccentSwatch}"
                                                                 Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="点击主题立即预览并保存，其余设置需要点保存" Style="{StaticResource Hint}"
                                               Margin="2,2,2,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="自定义" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                        <TextBlock Text="自定义主题目录" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="ThemePathText" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="24,0,0,0"
                                            VerticalAlignment="Center" Click="OnOpenThemesFolder">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFolder}" StrokeThickness="1.4"
                                                      Stroke="{DynamicResource Text2Brush}"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="打开目录" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="把 .json 主题放进该目录后重新打开设置窗口即可看到。"
                                       Style="{StaticResource Hint}" Margin="2,0,0,0"/>

                            <TextBlock Text="显示器与位置" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="显示器" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="岛体放在哪块屏幕；直接拖动收起态岛体即可移动并吸附边缘"
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="MonitorBox" Grid.Column="1" Width="200"
                                                  DisplayMemberPath="DeviceName" Margin="24,0,0,0"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="展开宽度" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="也可以用展开面板右下角拖拽调整"
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Slider x:Name="PanelWidthSlider" Style="{StaticResource SlimSlider}"
                                                    Width="180" Minimum="420" Maximum="900"
                                                    ValueChanged="OnPanelWidthChanged"/>
                                            <TextBlock x:Name="PanelWidthValue" Style="{StaticResource Hint}"
                                                       Width="54" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="重置位置" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="清除拖动记忆，回到上方选定的吸附位置"
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="24,0,0,0"
                                                Click="OnResetPositionClick" Content="重置"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="自动切换" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="切换方式" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="跟随系统明暗，或按本地时间在浅色/深色主题间切换"
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" Margin="24,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ModeManual" GroupName="ThemeMode"
                                                             Style="{StaticResource Segment}" Content="手动"/>
                                                <RadioButton x:Name="ModeSystem" GroupName="ThemeMode"
                                                             Style="{StaticResource Segment}" Content="跟随系统"/>
                                                <RadioButton x:Name="ModeDaylight" GroupName="ThemeMode"
                                                             Style="{StaticResource Segment}" Content="白天/夜晚"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="浅色 / 深色主题" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="定时模式默认 07:00–19:00 使用浅色主题"
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0"
                                                    VerticalAlignment="Center">
                                            <ComboBox x:Name="LightThemeBox" Width="150" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="DarkThemeBox" Width="150"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                            <TextBlock Text="跟随系统高对比度" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="开启后使用系统窗口色/高亮色，优先保证可读性"
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HighContrastSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Margin="24,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="主题编辑器" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="EditThemeName" Grid.Column="1" Style="{StaticResource Field}"
                                                 Text="我的主题"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="背景" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="EditSurface" Grid.Column="1" Style="{StaticResource Field}"
                                                 Text="#101014"/>
                                        <TextBlock Grid.Column="2" Text="正文" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="EditText" Grid.Column="3" Style="{StaticResource Field}"
                                                 Text="#F5F5F7"/>
                                        <TextBlock Grid.Column="4" Text="强调" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="EditAccent" Grid.Column="5" Style="{StaticResource Field}"
                                                 Text="#0A84FF"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="颜色支持 #RGB / #RRGGBB / #AARRGGBB；次要文字与分隔线自动派生。"
                                                   Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Margin="10,0,8,0"
                                                    Click="OnLoadCurrentThemeClick" Content="取当前主题"/>
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    Click="OnSaveThemeEditorClick" Content="保存并应用"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 功能 -->
                    <ScrollViewer x:Name="PageFeatures" Style="{StaticResource PageScroll}" Margin="30,0,18,0"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,2,0,26">
                            <TextBlock Text="功能模块" Style="{StaticResource GroupLabel}"/>
                            <TextBlock Text="用 ↑ ↓ 调整灵动岛里的标签顺序；带「设置」的模块可在二级菜单里配置。"
                                       Style="{StaticResource Hint}" Margin="2,0,0,10"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="FeatureList"/>
                            </Border>

                            <TextBlock Text="性能" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                        <TextBlock Text="空闲退出秒数" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="所有功能共用；子进程空闲超过该时长后退出，0 = 立即退出。"
                                                   Style="{StaticResource RowDesc}" MaxWidth="420" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                        <TextBox x:Name="IdleExitBox" Style="{StaticResource Field}" Width="84"
                                                 TextAlignment="Right"/>
                                        <TextBlock Text="秒" Style="{StaticResource Hint}" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 功能模块的二级设置 -->
                    <ScrollViewer x:Name="PageModule" Style="{StaticResource PageScroll}" Margin="30,0,18,0"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,2,0,26">
                            <Button x:Name="ModuleBack" HorizontalAlignment="Left" Style="{StaticResource GhostButton}"
                                    Height="30" Padding="12,0" Click="OnModuleBack">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="返回" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="ModuleMonitor" Visibility="Collapsed">
                                <TextBlock Text="系统监控" Style="{StaticResource GroupLabel}"/>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="监控数据源" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="温度、风扇与功耗的读取方式；自动会优先使用检测到的外部程序。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,12"/>
                                        <Border Style="{StaticResource SegmentGroup}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="MonitorAuto" GroupName="MonitorSource" Style="{StaticResource SegmentTight}"
                                                             Content="自动"/>
                                                <RadioButton x:Name="MonitorInternal" GroupName="MonitorSource" Style="{StaticResource SegmentTight}"
                                                             Content="内置"/>
                                                <RadioButton x:Name="MonitorLhm" GroupName="MonitorSource" Style="{StaticResource SegmentTight}"
                                                             Content="LibreHardwareMonitor"/>
                                                <RadioButton x:Name="MonitorOhm" GroupName="MonitorSource" Style="{StaticResource SegmentTight}"
                                                             Content="OpenHardwareMonitor"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="DetectedSourcesText" Style="{StaticResource Hint}" Margin="2,12,0,0"
                                                   Text="未检测到外部监控软件"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ModuleWeather" Visibility="Collapsed">
                                <TextBlock Text="天气" Style="{StaticResource GroupLabel}"/>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="地区" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="留空则按 IP 自动定位；可直接写中文城市名，例如 上海、杭州、Tokyo。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,10"/>
                                        <TextBox x:Name="WeatherLocation" Style="{StaticResource Field}" Width="260"
                                                 HorizontalAlignment="Left" Text=""/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ModuleMusic" Visibility="Collapsed">
                                <TextBlock Text="外部程序" Style="{StaticResource GroupLabel}"/>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="音乐程序" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="控制页点「音乐」时启动的程序；留空则打开系统默认音乐应用。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MusicPath" Grid.Column="0" Style="{StaticResource Field}"/>
                                            <Button x:Name="BrowseMusic" Grid.Column="2" Content="浏览…"
                                                    Style="{StaticResource GhostButton}" Height="32" Padding="12,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ModuleTranslate" Visibility="Collapsed">
                                <TextBlock Text="翻译" Style="{StaticResource GroupLabel}"/>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="翻译引擎" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="自动：填了 DeepSeek Key 就优先用它，否则走 Google 翻译（失败退回 MyMemory）。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,12"/>
                                        <Border Style="{StaticResource SegmentGroup}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="TranslateAuto" GroupName="TranslateEngine"
                                                             Style="{StaticResource SegmentTight}" Content="自动"/>
                                                <RadioButton x:Name="TranslateGoogle" GroupName="TranslateEngine"
                                                             Style="{StaticResource SegmentTight}" Content="Google 翻译"/>
                                                <RadioButton x:Name="TranslateMyMemory" GroupName="TranslateEngine"
                                                             Style="{StaticResource SegmentTight}" Content="MyMemory"/>
                                                <RadioButton x:Name="TranslateDeepSeek" GroupName="TranslateEngine"
                                                             Style="{StaticResource SegmentTight}" Content="DeepSeek"/>
                                                <RadioButton x:Name="TranslateBaidu" GroupName="TranslateEngine"
                                                             Style="{StaticResource SegmentTight}" Content="百度翻译"/>
                                                <RadioButton x:Name="TranslateMicrosoft" GroupName="TranslateEngine"
                                                             Style="{StaticResource SegmentTight}" Content="微软翻译"/>
                                                <RadioButton x:Name="TranslateCustom" GroupName="TranslateEngine"
                                                             Style="{StaticResource SegmentTight}" Content="自定义大模型"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="百度翻译" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="在百度翻译开放平台申请通用文本翻译，AppID 与密钥都填这里；密钥用 Windows DPAPI 加密保存。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="AppID" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                                <TextBox x:Name="BaiduAppId" Style="{StaticResource Field}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="密钥" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                                <PasswordBox x:Name="BaiduKey" Style="{StaticResource PwdField}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="微软翻译" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Azure 认知服务的翻译密钥；区域可留空（多区域资源需要填写，例如 eastasia）。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="密钥" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                                <PasswordBox x:Name="MicrosoftKey" Style="{StaticResource PwdField}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="区域（可选）" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                                <TextBox x:Name="MicrosoftRegion" Style="{StaticResource Field}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="自定义大模型" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="任何 OpenAI 兼容的 /chat/completions 端点，例如 Ollama、vLLM 或第三方中转。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,10"/>
                                        <StackPanel>
                                            <TextBlock Text="接口地址" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                            <TextBox x:Name="CustomEndpoint" Style="{StaticResource Field}"/>
                                        </StackPanel>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="模型" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                                <TextBox x:Name="CustomModel" Style="{StaticResource Field}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="密钥（可留空）" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                                <PasswordBox x:Name="CustomKey" Style="{StaticResource PwdField}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ModuleStocks" Visibility="Collapsed">
                                <TextBlock Text="股票" Style="{StaticResource GroupLabel}"/>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="自选股" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="腾讯行情代码，用英文逗号分隔，例如 sh600519,hk00700。留空则使用默认六只。"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,10"/>
                                        <TextBox x:Name="StockSymbols" Style="{StaticResource Field}"
                                                 AcceptsReturn="False" Height="34"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="刷新间隔（秒）" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                                                <TextBox x:Name="StockRefresh" Style="{StaticResource Field}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 用量 -->
                    <ScrollViewer x:Name="PageUsage" Style="{StaticResource PageScroll}" Margin="30,0,18,0"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,2,0,26">
                            <TextBlock Text="数据来源" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="勾选需要汇总的来源；未勾选的来源不会启动子进程。"
                                               Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                    <UniformGrid x:Name="SourceList" Columns="3" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="来源密钥" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="SecretsHost"/>
                            </Border>
                            <TextBlock Text="已保存的密钥显示为 ••••••，不修改则不会覆盖；清空输入框并保存可删除。密钥使用 Windows DPAPI（当前用户）加密保存在 secrets.dat，不写入 config.json。"
                                       Style="{StaticResource Hint}" Margin="2,0,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="站点地址" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="NewAPI 站点（例如 https://api.example.com）" Style="{StaticResource Hint}"/>
                                    <TextBox x:Name="NewApiSite" Style="{StaticResource Field}" Margin="0,6,0,14"/>
                                    <TextBlock Text="Sub2API 站点（例如 https://sub.example.com）" Style="{StaticResource Hint}"/>
                                    <TextBox x:Name="Sub2ApiSite" Style="{StaticResource Field}" Margin="0,6,0,2"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="刷新" Style="{StaticResource GroupLabel}" Margin="2,22,0,8"/>
                            <Border Style="{StaticResource Card}">
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                        <TextBlock Text="刷新间隔" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="单位秒；所有来源共用同一个刷新节奏" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                        <TextBox x:Name="RefreshBox" Style="{StaticResource Field}" Width="84"
                                                 TextAlignment="Right"/>
                                        <TextBlock Text="秒" Style="{StaticResource Hint}" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 关于 -->
                    <ScrollViewer x:Name="PageAbout" Style="{StaticResource PageScroll}" Margin="30,0,18,0"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,2,0,26">
                            <Border Style="{StaticResource Card}" Padding="22,22">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="60" Height="60" CornerRadius="17" Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="K" FontSize="27" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Kojima" FontSize="20" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                                    <TextBlock x:Name="AboutVersionBadge" Text="1.2.1" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="一个把 AI 用量和系统状态放在屏幕边缘的 Windows 小工具"
                                                       Style="{StaticResource Hint}" FontSize="11.5" Margin="0,6,0,0"
                                                       MaxWidth="430" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource RowDivider}" Margin="0,20,0,0"/>

                                    <Grid Margin="0,14,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="自动检查更新" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="每天启动后最多检查一次 GitHub Releases，只提示不强制"
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Text=""/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button x:Name="CheckUpdateButton" Style="{StaticResource GhostButton}"
                                                    Content="检查更新" Click="OnCheckUpdateClick"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GitHub 仓库" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                            <Hyperlink NavigateUri="https://github.com/mengtiankf/kojima"
                                                       RequestNavigate="OnGitHubNavigate" TextDecorations="None"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Cursor="Hand">github.com/mengtiankf/kojima</Hyperlink>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Margin="0,10,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="主题作者" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5"
                                                   Foreground="{DynamicResource Text2Brush}">BrimDeck（Apache-2.0）</TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="致谢" Style="{StaticResource GroupLabel}"/>
                            <Border Style="{StaticResource Card}" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="Island 材质与主题来自 BrimDeck，Apache-2.0"
                                               Style="{StaticResource RowTitle}" FontSize="12.5"/>
                                    <TextBlock Text="设置面板的构图参考了 BrimDeck 的设置页；主题色的语义命名与 WPF 画刷封装沿用同一套约定。"
                                               Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AboutVersionLine" Text="Kojima 1.2.1 · Windows · .NET 10 · WPF" Style="{StaticResource Hint}"
                                       Margin="2,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底部操作条 -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}">
                    <Grid Margin="30,0,24,0" Height="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Opacity="0.9"
                                     Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="9,0,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Text="主题切换会立即生效，其余设置点击保存后应用。"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="取消"
                                    Margin="0,0,10,0" Click="OnCancelClick"/>
                            <Button x:Name="ApplyButton" Style="{StaticResource GhostButton}" Content="应用"
                                    Margin="0,0,10,0" Click="OnApplyClick"/>
                            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存"
                                    Click="OnSaveClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
