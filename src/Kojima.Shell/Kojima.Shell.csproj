<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Version>1.3.2</Version>
    <RootNamespace>Kojima.Shell</RootNamespace>
    <AssemblyName>Kojima</AssemblyName>
    <ApplicationIcon>..\..\assets\kojima.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kojima.Core\Kojima.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\assets\kojima.ico" Link="assets\kojima.ico" />
  </ItemGroup>

</Project>
