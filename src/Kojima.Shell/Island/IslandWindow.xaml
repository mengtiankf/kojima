<Window x:Class="Kojima.Shell.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kojima.Shell.Island"
        Title="Kojima"
        Width="238" Height="34"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid x:Name="Root">
        <local:IslandSurface x:Name="Surface" />

        <!-- 收起态：时钟 + 天气 -->
        <Grid x:Name="Compact" Margin="0,0,0,0">
            <TextBlock x:Name="ClockText"
                       Text="21:04"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0"
                       HorizontalAlignment="Left" />

            <StackPanel x:Name="WeatherStack"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,16,0">
                <TextBlock x:Name="WeatherIcon"
                           Text="&#xE753;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0" />
                <TextBlock x:Name="WeatherText"
                           Text="--°"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MediaText"
                       Text=""
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </Grid>

        <!-- 展开态：导航 + 页面 -->
        <Grid x:Name="Panel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="NavRow" Grid.Row="0" Height="38" Margin="12,8,12,4">
                <TextBlock x:Name="PanelClock"
                           Text="21:04"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <Grid x:Name="PageHost" Grid.Row="1" Margin="12,0,12,12" />
        </Grid>
    </Grid>
</Window>
