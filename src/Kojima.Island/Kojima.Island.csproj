<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Version>1.3.4-beta.1</Version>
    <RootNamespace>Kojima.Island</RootNamespace>
    <AssemblyName>Kojima.Island</AssemblyName>
    <ApplicationIcon>..\..\assets\kojima.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kojima.Core\Kojima.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\assets\kojima.ico" Link="assets\kojima.ico" />
  </ItemGroup>


</Project>
