<Window x:Class="Kojima.Island.Ui.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Kojima.Island.Theme"
        Title="Kojima" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{x:Static theme:ThemeRuntime.UiFont}" FontSize="13"
        Foreground="{DynamicResource DialogTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="DialogButtonBase" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{DynamicResource DialogAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogOnAccentBrush}"/>
        </Style>

        <Style x:Key="DialogGhostButton" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{DynamicResource DialogFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogText2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <TextBlock Text="&#xE711;" FontFamily="{x:Static theme:ThemeRuntime.IconFont}"
                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogHairlineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border x:Name="Card" CornerRadius="14" BorderThickness="1"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource DialogHairlineBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.34" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadge" Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource DialogAccentSoftBrush}">
                        <TextBlock x:Name="IconGlyph" FontFamily="{x:Static theme:ThemeRuntime.IconFont}"
                                   FontSize="15" Foreground="{DynamicResource DialogAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="11,0,8,0"
                               VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource DialogTextBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource DialogCloseButton}"
                            Click="OnCancelClick" AutomationProperties.Name="关闭"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" MaxHeight="300"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource DialogText2Brush}"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource DialogGhostButton}"
                            Click="OnCancelClick" Margin="0,0,10,0"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource DialogPrimaryButton}"
                            Click="OnPrimaryClick" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
